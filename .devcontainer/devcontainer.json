{
  "name": "MediQA Java 17 - Citas Médicas y Auditoría McCabe",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bullseye",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "MediQA Java 17 Web App (Puerto 3000)",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "chmod +x ejecutar_todo.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack"
      ]
    }
  }
}
